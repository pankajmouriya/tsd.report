    "editorial": {
      "title": "Rails Active Storage uploads can expose server files through ImageMagick",
      "summary": "Rails’ November 4 advisory describes arbitrary file writes during attachment analysis when Active Storage uses ImageMagick, accepts untrusted uploads, and lacks a restrictive coder policy. Disk-backed storage can also expose files readable by the app.",
      "why_it_matters": "Attachment analysis runs when a file is attached; a separate preview or variant request is not required. Check the image processor, upload trust boundary and ImageMagick policy together.",
      "action": "Upgrade Active Storage to 8.1.4.1 or 8.0.5.2 and use MiniMagick 5.1 or later for :mini_magick. For Disk storage, rotate app-readable secrets as the upstream advisory directs.",
