---
import '../styles/global.css';
import { getContentMode, isIncidentPreview, isSyntheticIncidentPreview } from '../lib/content';
interface Props { title?: string; description?: string; canonical?: string; }
const { title = 'The Security Diff', description = 'Security engineering, without the noise.', canonical = '/' } = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site);
const fixture = getContentMode() === 'fixture';
const incidentPreview = isIncidentPreview();
const deploymentSha = process.env.TSD_DEPLOYMENT_SHA;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#faf6ea" />
    <meta name="description" content={description} />
    {deploymentSha && /^[a-f0-9]{40}$/.test(deploymentSha) && <meta name="tsd-revision" content={deploymentSha} />}
    <meta name="robots" content={fixture || incidentPreview ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preload" href="/fonts/grenze-gotisch-masthead-bold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/newsreader-display-semibold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title === 'The Security Diff' ? title : `${title} · The Security Diff`}</title>
    <script is:inline>try{const t=localStorage.getItem('tsd-theme');const d=t==='dark'||(!t&&matchMedia('(prefers-color-scheme: dark)').matches);document.documentElement.dataset.theme=d?'dark':'light';document.querySelector('meta[name="theme-color"]')?.setAttribute('content',d?'#211f1b':'#faf6ea')}catch{}</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="paper">
      {fixture && <div class="fixture-notice">Fixture preview</div>}
      {incidentPreview && <div class="fixture-notice">{isSyntheticIncidentPreview() ? 'Synthetic fixture · ' : ''}Incident draft preview · Unreviewed · Not published</div>}
      <slot />
    </div>
  </body>
</html>
