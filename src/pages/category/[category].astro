---
import BrowseLayout from '../../layouts/BrowseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getStories, getStoryCategories } from '../../lib/content';
import { categoryPath } from '../../lib/routes';
export function getStaticPaths() { return getStoryCategories().map((category) => ({ params: { category }, props: { category } })); }
const { category } = Astro.props;
const stories = getStories().filter((story) => story.category === category);
const title = category.replaceAll('-', ' ');
---
<BrowseLayout title={title} canonical={categoryPath(category)}>
  <main id="main" class="browse-page"><header class="browse-heading"><h1>{title}</h1><p>{stories.length} {stories.length === 1 ? 'story' : 'stories'}</p></header><div class="story-grid">{stories.map((story) => <StoryCard story={story} />)}</div></main>
</BrowseLayout>
