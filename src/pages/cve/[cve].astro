---
import BaseLayout from '../../layouts/BaseLayout.astro'; import EditionHeader from '../../components/EditionHeader.astro'; import EditionFooter from '../../components/EditionFooter.astro'; import { getCves, getLatestEdition, getStoriesForCve } from '../../lib/content'; import { cvePath, articlePath } from '../../lib/routes'; import { formatProbability } from '../../lib/format';
export function getStaticPaths() { return getCves().map((cve) => ({ params: { cve }, props: { cve } })); }
const { cve } = Astro.props; const edition = getLatestEdition(); const stories = getStoriesForCve(cve); const vulnerability = stories[0].vulnerabilities.find((item) => item.cve === cve)!;
---
<BaseLayout title={cve} canonical={cvePath(cve)}><EditionHeader date={edition.date} count={stories.length} /><main id="main" class="article"><p class="eyebrow">Vulnerability intelligence · Historical fixture</p><h1>{cve}</h1><p class="dek">This page demonstrates evidence presentation using a historical vulnerability. Values are dated and are not a current alert.</p><div class="article-panel"><p><strong>CVSS</strong> {vulnerability.cvss ?? 'Not available'} {vulnerability.cvss_version ? `(v${vulnerability.cvss_version})` : ''}</p><p><strong>EPSS</strong> {formatProbability(vulnerability.epss)}</p><p><strong>CISA KEV</strong> {vulnerability.kev == null ? 'Unknown' : vulnerability.kev ? 'Yes' : 'No'}</p><p><strong>Known exploitation</strong> {vulnerability.exploitation.replace('-', ' ')}</p><p><strong>Evidence date</strong> {vulnerability.evidence_date ?? 'Not available'}</p></div><h2>Affected</h2><p>{vulnerability.affected.join(', ') || 'Not available'}</p><h2>Fixed</h2><p>{vulnerability.fixed_versions.join(', ') || 'No authoritative fixed version recorded'}</p><h2>Coverage</h2><ul>{stories.map((story) => <li><a href={articlePath(story.slug)}>{story.title}</a></li>)}</ul></main><EditionFooter /></BaseLayout>
