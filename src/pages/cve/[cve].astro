---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { findEditionForStory, getContentMode, getCves, getStoriesForCve } from '../../lib/content';
import { findVulnerabilityWatchEntry, getVulnerabilityWatchCves } from '../../lib/vulnerability-watch';
import { cvePath, storyDestination } from '../../lib/routes';
import { formatProbability, formatShortDate } from '../../lib/format';
export function getStaticPaths() { return [...new Set([...getCves(), ...getVulnerabilityWatchCves()])].map((cve) => ({ params: { cve }, props: { cve } })); }
const { cve } = Astro.props;
const stories = getStoriesForCve(cve);
const watch = findVulnerabilityWatchEntry(cve);
const storyVulnerability = stories[0]?.vulnerabilities.find((item) => item.cve === cve);
const edition = stories[0] ? findEditionForStory(stories[0].slug) : undefined;
const sources = watch?.entry.references ?? [...new Map(stories.flatMap((story) => story.sources).map((source) => [source.id, source])).values()];
const cvss = watch?.entry.cvss?.score ?? storyVulnerability?.cvss ?? null;
const cvssVersion = watch?.entry.cvss?.version ?? storyVulnerability?.cvss_version ?? null;
const epss = watch?.entry.epss.probability ?? storyVulnerability?.epss ?? null;
const epssPercentile = watch?.entry.epss.percentile ?? storyVulnerability?.epss_percentile ?? null;
const kev = watch ? true : storyVulnerability?.kev ?? null;
const exploitation = watch ? 'confirmed' : storyVulnerability?.exploitation ?? 'unknown';
const affected = watch ? [`${watch.entry.kev.vendor_project} ${watch.entry.kev.product}`] : storyVulnerability?.affected ?? [];
const fixedVersions = storyVulnerability?.fixed_versions ?? [];
const evidenceDate = watch?.entry.epss.score_date ?? storyVulnerability?.evidence_date ?? null;
const fixture = getContentMode() === 'fixture';
---
<ArticleLayout title={cve} description={`Dated vulnerability record for ${cve}`} canonical={cvePath(cve)} editionDate={watch?.snapshot.date ?? edition?.date}>
  <main id="main" class="reading-article reading-article--reference">
    <header class="article-opening">
      <p class="article-kicker">Vulnerability intelligence{fixture && ' · Historical fixture'}</p>
      <h1 translate="no">{cve}</h1>
      <p class="dek">{fixture ? 'A dated fixture record separating severity, probability, exploitation evidence, and remediation information. It is not a current alert.' : 'A dated record separating severity, probability, exploitation evidence, and remediation information.'}</p>
      <p class="article-meta">Evidence as of {evidenceDate ? <time datetime={evidenceDate}>{formatShortDate(evidenceDate)}</time> : 'unknown'}</p>
    </header>
    <div class="article-body">
      <dl class="cve-facts">
        <dt>CVSS</dt><dd>{cvss ?? 'Not available'} {cvssVersion ? `(v${cvssVersion})` : ''}</dd>
        <dt>EPSS probability</dt><dd>{formatProbability(epss)}</dd>
        <dt>EPSS percentile</dt><dd>{formatProbability(epssPercentile)}</dd>
        <dt>KEV</dt><dd>{kev == null ? 'Unknown' : kev ? 'Yes' : 'No'} {fixture && !watch && <small>Fixture value; claim-level source not yet recorded.</small>}</dd>
        <dt>Known exploitation</dt><dd>{exploitation.replace('-', ' ')}</dd>
        <dt>Affected</dt><dd>{affected.join(', ') || 'Not available'}</dd>
        <dt>Fixed information</dt><dd>{fixedVersions.join(', ') || 'No authoritative fixed version recorded'}</dd>
      </dl>
      {watch && <><h2>Required action</h2><p>{watch.entry.kev.required_action}</p>{watch.entry.description && <><h2>Description</h2><p>{watch.entry.description}</p></>}</>}
      <h2>Coverage</h2>
      {stories.length > 0 ? <ul>{stories.map((story) => <li><a href={storyDestination(story)}>{story.title}</a></li>)}</ul> : <p>No separate Security Diff story is recorded for this CVE.</p>}
      <h2>Recorded sources</h2>
      <ul>{sources.map((source) => <li><a href={source.url} rel="noreferrer">{source.name}</a> · retrieved {formatShortDate(source.retrieved_at)}</li>)}</ul>
      {fixture && <p><strong>Evidence limitation:</strong> the fixture does not yet associate each intelligence field with an independent source record. Unknown or unsupported values must remain explicit.</p>}
    </div>
  </main>
</ArticleLayout>
