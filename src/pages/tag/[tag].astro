---
import BrowseLayout from '../../layouts/BrowseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getStories } from '../../lib/content';
import { tagPath } from '../../lib/routes';
export function getStaticPaths() { return [...new Set(getStories().flatMap((story) => story.tags))].map((tag) => ({ params: { tag }, props: { tag } })); }
const { tag } = Astro.props;
const stories = getStories().filter((story) => story.tags.includes(tag));
---
<BrowseLayout title={`#${tag}`} canonical={tagPath(tag)}>
  <main id="main" class="browse-page"><header class="browse-heading"><h1>#{tag}</h1><p>{stories.length} {stories.length === 1 ? 'story' : 'stories'}</p></header><div class="story-grid">{stories.map((story) => <StoryCard story={story} />)}</div></main>
</BrowseLayout>
