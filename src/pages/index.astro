---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditionView from '../components/EditionView.astro';
import { assertContentMode, getEditions, getLatestEdition } from '../lib/content';
import { getLatestVulnerabilityWatch } from '../lib/vulnerability-watch';
assertContentMode();
const edition = getLatestEdition();
const editions = getEditions();
const vulnerabilityWatch = getLatestVulnerabilityWatch();
---
<BaseLayout canonical="/"><EditionView edition={edition} previous={editions[1]?.date} vulnerabilityWatch={vulnerabilityWatch} /></BaseLayout>
