---
import taxonomy from '../../config/taxonomy.json';
---
<section class="filters" aria-label="Edition filters" data-filters>
  <div class="filter-row" data-group="topic"><span class="filter-label">Topic</span><button class="filter-button" data-value="all" aria-pressed="true">All</button>{taxonomy.categories.map((category) => <button class="filter-button" data-value={category.id} aria-pressed="false">{category.label}</button>)}</div>
  <div class="filter-row" data-group="signal"><span class="filter-label">Signal</span><button class="filter-button" data-value="all" aria-pressed="true">All</button><button class="filter-button" data-value="recommended" aria-pressed="false">Recommended</button><button class="filter-button" data-value="must-read" aria-pressed="false">Must Read</button></div>
  <div class="filter-meta"><span role="status" aria-live="polite" data-result-count>Showing the full edition</span><button class="reset" type="button" data-reset>Reset filters</button></div>
</section>

<script>
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  if (filters) {
    const allowedTopics = new Set(['all','vulnerabilities','supply-chain','ai-security','appsec','cloud','research','security-engineering']);
    const allowedSignals = new Set(['all','recommended','must-read']);
    const params = new URLSearchParams(location.search);
    let topic = allowedTopics.has(params.get('topic') ?? '') ? params.get('topic')! : 'all';
    let signal = allowedSignals.has(params.get('signal') ?? '') ? params.get('signal')! : 'all';
    const apply = (push = true) => {
      let count = 0;
      document.querySelectorAll<HTMLElement>('[data-story]').forEach((story) => {
        const signalMatch = signal === 'all' || story.dataset.signal === signal || (signal === 'recommended' && story.dataset.signal === 'must-read');
        const match = (topic === 'all' || story.dataset.category === topic) && signalMatch;
        story.hidden = !match;
        if (match) count++;
      });
      document.querySelectorAll<HTMLElement>('[data-group]').forEach((group) => group.querySelectorAll('button').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.value === (group.dataset.group === 'topic' ? topic : signal)))));
      document.querySelectorAll<HTMLElement>('[data-edition-section]').forEach((section) => section.hidden = section.querySelectorAll('[data-story]:not([hidden])').length === 0);
      const status = filters.querySelector('[data-result-count]');
      if (status) status.textContent = topic === 'all' && signal === 'all' ? 'Showing the full edition' : `${count} ${count === 1 ? 'story' : 'stories'} match`;
      const empty = document.querySelector<HTMLElement>('[data-no-results]');
      if (empty) empty.hidden = count !== 0;
      if (push) {
        const next = new URL(location.href); next.search = '';
        if (topic !== 'all') next.searchParams.set('topic', topic);
        if (signal !== 'all') next.searchParams.set('signal', signal);
        history.pushState({}, '', next);
      }
    };
    filters.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.filter-button');
      if (!button) return;
      const group = button.closest<HTMLElement>('[data-group]')?.dataset.group;
      if (group === 'topic') topic = button.dataset.value!;
      if (group === 'signal') signal = button.dataset.value!;
      apply();
    });
    filters.querySelector('[data-reset]')?.addEventListener('click', () => { topic = 'all'; signal = 'all'; apply(); });
    addEventListener('popstate', () => { const current = new URLSearchParams(location.search); topic = current.get('topic') ?? 'all'; signal = current.get('signal') ?? 'all'; apply(false); });
    apply(false);
  }
</script>
