---
import type { Edition } from '../lib/schema';
import { getStoryById } from '../lib/content';
import EditionHeader from './EditionHeader.astro';
import EditionFilters from './EditionFilters.astro';
import LeadStory from './LeadStory.astro';
import StoryCard from './StoryCard.astro';
import VulnerabilityWatch from './VulnerabilityWatch.astro';
import EditionFooter from './EditionFooter.astro';
interface Props { edition: Edition; previous?: string; next?: string; }
const { edition, previous, next } = Astro.props;
const lead = getStoryById(edition, edition.lead_story);
const secondary = Object.values(edition.sections).flat().filter((id, index, ids) => id !== lead.id && ids.indexOf(id) === index).map((id) => getStoryById(edition, id));
---
<EditionHeader date={edition.date} count={edition.stories.length} previous={previous} next={next} />
<EditionFilters />
<main id="main">
  <div data-edition-section><LeadStory story={lead} /></div>
  {secondary.length > 0 && <section class="story-grid" aria-label="Edition stories" data-edition-section>{secondary.map((story) => <StoryCard story={story} />)}</section>}
  <VulnerabilityWatch stories={edition.stories} date={edition.date} />
  <section class="no-results" data-no-results hidden><h2>No stories match</h2><p>Reset the filters to return to the full edition.</p></section>
</main>
<EditionFooter />
