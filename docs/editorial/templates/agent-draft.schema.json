{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TSD proposed editorial draft output v1",
  "description": "Documentation contract; not wired into the running application. Additional semantic evidence and markup validation is mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "summary",
    "why_it_matters",
    "action",
    "body_markdown",
    "claim_links",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "why_it_matters": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "body_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60000
    },
    "claim_links": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "claim_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  }
}
